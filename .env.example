# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Proxy pool health extras (optional)
# PROXY_WEBHOOK_URL=https://hooks.example.com/pools — POST {event:"pool.cooldown",...} when a pool enters cooldown
# DISABLE_PROXY_AUTO_UNBIND=1 — stop auto-detaching connections from dead pools

# Proxy auto-delete (optional)
# DISABLE_PROXY_AUTO_DELETE=1 — stop auto-deleting dead pools
# PROXY_AUTO_DELETE_THRESHOLD=3 — consecutive cooldown entries before deletion (default: 3)
# PROXY_AUTO_DELETE_GRACE_MS=86400000 — grace period after cooldown before deletion (default: 24h in ms)

# Proxy smart routing strategy (optional)
# PROXY_SMART_LATENCY_WEIGHT=0.3 — weight for latency factor (default: 0.3)
# PROXY_SMART_SUCCESS_WEIGHT=0.35 — weight for success rate factor (default: 0.35)
# PROXY_SMART_RECENCY_WEIGHT=0.2 — weight for recency factor (default: 0.2)
# PROXY_SMART_GEO_WEIGHT=0.15 — weight for geographic proximity factor (default: 0.15)
# PROXY_MAX_ACCEPTABLE_LATENCY_MS=5000 — max latency for normalization (default: 5000ms)
# PROXY_RECENCY_WINDOW_MS=3600000 — recency window for normalization (default: 1h in ms)
# PROXY_TARGET_REGION=US — preferred geographic region for geo scoring (default: none)

# Operational notifications (optional) — webhook notified on account locks,
# provider-wide outages, API-key limit hits, and all-accounts-failed exits.
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/9router
# NOTIFICATION_MIN_INTERVAL_MS=300000 — min ms between notifications per (event, scope)

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
